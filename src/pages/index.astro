---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { projects } from '../data/projects';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			:root {
				--bg-dark: #0a0e27;
				--bg-darker: #050811;
				--text-light: #e0e0e0;
				--text-muted: #a0a0a0;
				--accent: #00d4ff;
				--accent-hover: #00b8d4;
			}

			html {
				background-color: var(--bg-darker);
			}

			body {
				background: var(--bg-darker) !important;
				color: var(--text-light);
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
				line-height: 1.6;
				margin: 0;
				padding: 0;
			}

			main {
				background-color: var(--bg-darker);
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
			}

			/* Override any light backgrounds */
			body, main, section, div, p, h1, h2, h3, h4, h5, h6 {
				background-color: transparent !important;
			}

			.hero {
				min-height: 70vh;
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: 4rem 2rem;
				max-width: 1200px;
				margin: 0 auto;
				background-color: #050811 !important;
				background-image: none !important;
				background: #050811 !important;
			}

			.hero-content {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 2.5rem;
				flex-wrap: wrap;
			}

			.hero-text {
				flex: 1 1 320px;
				min-width: 0;
			}

			.hero-image {
				width: 220px;
				height: 220px;
				object-fit: cover;
				border-radius: 50%;
				border: 3px solid var(--accent);
				box-shadow: 0 20px 40px rgba(0, 212, 255, 0.15);
				flex-shrink: 0;
			}

			.hero-contact {
				flex: 0 1 260px;
				background: rgba(255, 255, 255, 0.03);
				border: 1px solid rgba(0, 212, 255, 0.1);
				border-radius: 12px;
				padding: 1.75rem;
			}

			.hero-contact h2 {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-light);
				margin-bottom: 0.75rem;
			}

			.hero-contact p {
				font-size: 0.95rem;
				color: var(--text-muted);
				margin-bottom: 1.25rem;
			}

			.hero-contact .social-links {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.75rem;
			}

			.hero h1 {
				font-size: 3.5rem;
				font-weight: 700;
				margin-bottom: 1rem;
				background: linear-gradient(135deg, #00d4ff, #0084ff);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}

			.hero .subtitle {
				font-size: 1.3rem;
				color: var(--text-muted);
				margin-bottom: 2rem;
				max-width: 600px;
			}
			.hero::before {
				display: none !important;
			}
			
			.hero::after {
				display: none !important;
			}
			.hero .description {
				font-size: 1.05rem;
				color: var(--text-light);
				max-width: 700px;
				line-height: 1.8;
				margin-bottom: 3rem;
			}

			.cta-buttons {
				display: flex;
				gap: 1rem;
				margin-bottom: 4rem;
				flex-wrap: wrap;
			}

			.cta-button {
				padding: 0.75rem 1.5rem;
				border-radius: 6px;
				text-decoration: none;
				font-weight: 600;
				transition: all 0.3s ease;
				border: 2px solid transparent;
				cursor: pointer;
			}

			.cta-primary {
				background-color: var(--accent);
				color: var(--bg-darker);
			}

			.cta-primary:hover {
				background-color: var(--accent-hover);
				transform: translateY(-2px);
			}

			.cta-secondary {
				background-color: transparent;
				color: var(--accent);
				border-color: var(--accent);
			}

			.cta-secondary:hover {
				background-color: rgba(0, 212, 255, 0.1);
			}

			section {
				padding: 6rem 2rem;
				max-width: 1200px;
				margin: 0 auto;
				background-color: var(--bg-darker);
			}

			.section-title {
				font-size: 2rem;
				font-weight: 700;
				margin-bottom: 3rem;
				color: var(--text-light);
				position: relative;
				padding-bottom: 1rem;
			}

			.section-title::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				width: 60px;
				height: 4px;
				background: linear-gradient(90deg, var(--accent), transparent);
				border-radius: 2px;
			}

			.timeline {
				position: relative;
				max-width: 1100px;
				margin: 0 auto;
				padding-top: 0.5rem;
			}

			.timeline::before {
				content: '';
				position: absolute;
				left: 50%;
				top: 0.4rem;
				bottom: 0.4rem;
				width: 2px;
				background: linear-gradient(180deg, var(--accent) 0%, rgba(0, 212, 255, 0.35) 55%, rgba(0, 212, 255, 0.08) 100%);
				transform: translateX(-50%);
			}

			.timeline-item {
				position: relative;
				width: 50%;
				padding-bottom: 3.5rem;
				opacity: 0;
				transform: translateY(28px);
				transition: opacity 0.6s ease, transform 0.6s ease;
			}

			.timeline-item.is-visible {
				opacity: 1;
				transform: translateY(0);
			}

			.timeline-item:nth-child(odd) {
				left: 0;
				padding-right: 3.25rem;
			}

			.timeline-item:nth-child(even) {
				left: 50%;
				padding-left: 3.25rem;
			}

			.timeline-node {
				position: absolute;
				top: 1.6rem;
				width: 14px;
				height: 14px;
				border-radius: 50%;
				background: var(--accent);
				box-shadow: 0 0 0 5px rgba(0, 212, 255, 0.12), 0 0 14px rgba(0, 212, 255, 0.55);
				z-index: 2;
			}

			.timeline-item:nth-child(odd) .timeline-node {
				right: -7px;
			}

			.timeline-item:nth-child(even) .timeline-node {
				left: -7px;
			}

			.timeline-connector {
				position: absolute;
				top: 2.15rem;
				width: 3.25rem;
				height: 2px;
				background: rgba(0, 212, 255, 0.25);
			}

			.timeline-item:nth-child(odd) .timeline-connector {
				right: 0;
			}

			.timeline-item:nth-child(even) .timeline-connector {
				left: 0;
			}

			.project-card {
				background: rgba(255, 255, 255, 0.05);
				border-radius: 12px;
				overflow: hidden;
				transition: all 0.3s ease;
				border: 1px solid rgba(0, 212, 255, 0.1);
				cursor: pointer;
				text-decoration: none;
				color: inherit;
				display: flex;
				gap: 1rem;
				padding: 1rem;
			}

			.project-card:hover {
				background: rgba(255, 255, 255, 0.08);
				border-color: rgba(0, 212, 255, 0.3);
				transform: translateY(-4px);
				box-shadow: 0 20px 40px rgba(0, 212, 255, 0.1);
			}

			.project-thumbnail {
				width: 100px;
				height: 100px;
				flex-shrink: 0;
				border-radius: 8px;
				background: linear-gradient(135deg, #1a1f3a, #0f1428);
				overflow: hidden;
			}

			.project-thumbnail img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.project-info {
				flex-grow: 1;
				min-width: 0;
				display: flex;
				flex-direction: column;
			}

			.project-title {
				font-size: 1rem;
				font-weight: 700;
				margin-bottom: 0.15rem;
				color: var(--text-light);
			}

			.project-subtitle {
				font-size: 0.75rem;
				color: var(--accent);
				font-weight: 600;
				margin-bottom: 0.4rem;
			}

			.project-description {
				font-size: 0.85rem;
				color: var(--text-muted);
				margin-bottom: 0.75rem;
			}

			.project-tags {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
				margin-top: auto;
			}

			.tag {
				background: rgba(0, 212, 255, 0.1);
				color: var(--accent);
				padding: 0.2rem 0.6rem;
				border-radius: 20px;
				font-size: 0.7rem;
				font-weight: 600;
			}

			.social-link {
				color: var(--accent);
				text-decoration: none;
				font-weight: 600;
				transition: all 0.3s ease;
				border-bottom: 2px solid transparent;
			}

			.social-link:hover {
				border-bottom-color: var(--accent);
				color: var(--accent-hover);
			}

			@media (max-width: 900px) {
				.timeline::before {
					left: 22px;
				}

				.timeline-item,
				.timeline-item:nth-child(odd),
				.timeline-item:nth-child(even) {
					width: 100%;
					left: 0;
					padding-left: 3.25rem;
					padding-right: 0;
				}

				.timeline-item:nth-child(odd) .timeline-node,
				.timeline-item:nth-child(even) .timeline-node {
					left: 15px;
					right: auto;
				}

				.timeline-item:nth-child(odd) .timeline-connector,
				.timeline-item:nth-child(even) .timeline-connector {
					left: 22px;
					right: auto;
					width: 1.75rem;
				}

				.project-card {
					gap: 0.85rem;
				}

				.project-thumbnail {
					width: 76px;
					height: 76px;
				}
			}

			@media (max-width: 768px) {
				.hero h1 {
					font-size: 2.5rem;
				}

				.hero .subtitle {
					font-size: 1.1rem;
				}

				.hero-content {
					flex-direction: column;
					gap: 2rem;
					text-align: center;
				}

				.hero-image {
					width: 180px;
					height: 180px;
				}

				.hero-contact {
					width: 100%;
				}

				.hero-contact .social-links {
					align-items: center;
				}

				.cta-buttons {
					justify-content: center;
				}

				section {
					padding: 4rem 1.5rem;
				}

				.section-title {
					font-size: 1.5rem;
				}

				.project-card {
					flex-direction: column;
				}

				.project-thumbnail {
					width: 100%;
					height: 150px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- HERO SECTION -->
			<section class="hero">
				<div class="hero-content">
					<div class="hero-text">
						<h1>Henry R. Smith</h1>
						<p class="subtitle">MIT MechE '25 | Mechanical Engineering & Innovation</p>
						<p class="description">
							Welcome to my engineering portfolio. I'm passionate about designing innovative solutions to
							complex mechanical problems. Below you'll find my featured projects.
						</p>
						<div class="cta-buttons">
							<a href="#projects" class="cta-button cta-primary">View Projects</a>
							<a href="/resume.pdf" target="_blank" class="cta-button cta-secondary">My Resume</a>
						</div>
					</div>
					<img src="/IMG_7177.jpg" alt="Henry R. Smith" class="hero-image" />
					<div class="hero-contact">
						<h2>Get In Touch</h2>
						<p>I'm always interested in hearing about new projects and opportunities. Feel free to reach out!</p>
						<div class="social-links">
							<a href="https://linkedin.com/in/henry-smith-mit/" target="_blank" class="social-link">LinkedIn</a>
							<a href="/resume.pdf" target="_blank" class="social-link">Download Resume</a>
						</div>
					</div>
				</div>
			</section>

			<!-- FEATURED PROJECTS SECTION -->
			<section id="projects">
				<h2 class="section-title">Featured Projects</h2>
				<div class="timeline">
					{projects.map((project) => (
						<div class="timeline-item">
							<div class="timeline-node"></div>
							<div class="timeline-connector"></div>
							<a href={`/projects/${project.slug}`} class="project-card">
								<div class="project-thumbnail">
									<img src={project.images[0].src} alt={project.images[0].alt} />
								</div>
								<div class="project-info">
									<h3 class="project-title">{project.title}</h3>
									<p class="project-subtitle">{project.subtitle}</p>
									<p class="project-description">{project.summary}</p>
									<div class="project-tags">
										{project.tags.map((tag) => <span class="tag">{tag}</span>)}
									</div>
								</div>
							</a>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const items = document.querySelectorAll<HTMLElement>('.timeline-item');
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
	);
	items.forEach((item) => observer.observe(item));
</script>
