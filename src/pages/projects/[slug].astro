---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: project,
	}));
}

const project = Astro.props;
const { title, subtitle, summary, tags, highlights, images } = project;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Henry R. Smith`} description={summary} />
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			:root {
				--bg-dark: #0a0e27;
				--bg-darker: #050811;
				--text-light: #e0e0e0;
				--text-muted: #a0a0a0;
				--accent: #00d4ff;
				--accent-hover: #00b8d4;
			}

			html {
				background-color: var(--bg-darker);
			}

			body {
				background-color: var(--bg-darker);
				color: var(--text-light);
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
				line-height: 1.6;
			}

			body,
			main,
			section,
			div,
			p,
			h1,
			h2,
			h3,
			h4,
			h5,
			h6 {
				background-color: transparent !important;
			}

			.back-link {
				display: inline-block;
				margin-bottom: 1.5rem;
				color: var(--accent);
				text-decoration: none;
				font-weight: 600;
			}

			.back-link:hover {
				color: var(--accent-hover);
			}

			.project-header {
				max-width: 900px;
				margin: 0 auto;
				padding: 4rem 2rem 2rem;
			}

			.project-header h1 {
				font-size: 2.5rem;
				font-weight: 700;
				margin-bottom: 0.5rem;
				background: linear-gradient(135deg, #00d4ff, #0084ff);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}

			.project-header .subtitle {
				font-size: 1.2rem;
				color: var(--text-muted);
				margin-bottom: 1.5rem;
			}

			.project-header .summary {
				font-size: 1.05rem;
				max-width: 700px;
				margin-bottom: 1.5rem;
			}

			.tags {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
			}

			.tag {
				background: rgba(0, 212, 255, 0.1);
				color: var(--accent);
				padding: 0.25rem 0.75rem;
				border-radius: 20px;
				font-size: 0.8rem;
				font-weight: 600;
			}

			.highlights-section {
				max-width: 900px;
				margin: 0 auto;
				padding: 1rem 2rem 3rem;
			}

			.highlights-section h2 {
				font-size: 1.3rem;
				color: var(--accent);
				margin-bottom: 1rem;
			}

			.highlights-section ul {
				padding-left: 1.25rem;
			}

			.highlights-section li {
				margin-bottom: 0.6rem;
				color: var(--text-light);
			}

			.gallery {
				max-width: 1200px;
				margin: 0 auto;
				padding: 1rem 2rem 6rem;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 2rem;
			}

			figure {
				background: rgba(255, 255, 255, 0.03);
				border: 1px solid rgba(0, 212, 255, 0.1);
				border-radius: 12px;
				overflow: hidden;
			}

			figure img {
				width: 100%;
				height: auto;
				display: block;
			}

			figcaption {
				padding: 1rem 1.25rem;
				color: var(--text-muted);
				font-size: 0.9rem;
			}

			@media (max-width: 768px) {
				.project-header {
					padding: 2.5rem 1.5rem 1.5rem;
				}

				.project-header h1 {
					font-size: 1.8rem;
				}

				.gallery {
					padding: 1rem 1.5rem 4rem;
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="project-header">
				<a href="/#projects" class="back-link">&larr; All Projects</a>
				<h1>{title}</h1>
				<p class="subtitle">{subtitle}</p>
				<p class="summary">{summary}</p>
				<div class="tags">
					{tags.map((tag) => <span class="tag">{tag}</span>)}
				</div>
			</div>
			<div class="highlights-section">
				<h2>Highlights</h2>
				<ul>
					{highlights.map((h) => <li>{h}</li>)}
				</ul>
			</div>
			<div class="gallery">
				{images.map((img) => (
					<figure>
						<img src={img.src} alt={img.alt} loading="lazy" />
						{img.caption && <figcaption>{img.caption}</figcaption>}
					</figure>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
